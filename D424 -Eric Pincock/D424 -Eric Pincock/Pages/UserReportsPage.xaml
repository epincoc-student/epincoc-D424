<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
   xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="D424__Eric_Pincock.Pages.UserReportsPage"
             Title="TermsDetails"
             x:Name="TermsDetailsRoot"
             BackgroundColor="#F5F0F6">
    <AbsoluteLayout>
        <Grid RowDefinitions="0.15*,0.85*"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All">
            <!-- Page Banner -->
            <Grid Grid.Row="0" BackgroundColor="#25564E" Padding="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Back Button -->
                <Button Grid.Column="0"
                        Text="←"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="#F5F0F6"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Clicked="OnBackButtonClicked" />
                <!-- Page Title -->
                <Label Grid.Column="1"
                       Text="User Reports"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#F5F0F6"
                       VerticalOptions="Center"
                       HorizontalOptions="Start" />
                <!-- Menu button -->
                <Button Grid.Column="2"
                        Text="..."
                        FontSize="35"
                        FontAttributes="Bold"
                        TextColor="#F5F0F6"
                        BackgroundColor="Transparent"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Clicked="DetailsButton_Clicked" />
            </Grid>
            <!-- Display Reports Area -->
            <Grid Grid.Row="1" Padding="20" RowDefinitions="Auto,Auto,*,Auto">
                <!-- Report Type Label -->
                <VerticalStackLayout Grid.Row="0"
                                     Spacing="10">
                    <Label Text="Select Report Type"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#333" />
                    <Picker Grid.Row="1"
                            Title="Choose a report"
                            ItemsSource="{Binding ReportOptions}"
                            SelectedItem="{Binding SelectedReportType, Mode=TwoWay}"
                            FontSize="16"
                            TextColor="Black"
                            BackgroundColor="White" />
                    <!-- Run Report Button -->
                    <Button Padding="10"
                        Text="Run Report"
                        BackgroundColor="#25564E"
                        TextColor="#F5F0F6"
                        FontAttributes="Bold"
                        WidthRequest="200"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Clicked="RunReportButton_Clicked" />
                </VerticalStackLayout>
                <!-- Report Picker -->
                <CollectionView Grid.Row="2"
                    x:Name="ReportResultsView"
                    ItemsSource="{Binding ReportResults}"
                    Margin="0,20,0,0"
                    SelectionMode="None"
                    VerticalOptions="FillAndExpand">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10" Margin="5" BackgroundColor="White" BorderColor="#8BB174" CornerRadius="10">
                                <VerticalStackLayout>
                                    <Label Text="{Binding DisplayCourseWithCredits}" FontSize="16" TextColor="#333"/>
                                    <Label Text="{Binding Status, StringFormat='Course Status: {0}'}" FontSize="14" TextColor="#666"/>
                                    <Label Text="{Binding PreReqName, StringFormat='Prerequisites: {0}'}" FontSize="14" TextColor="#666" />
                                    <Label Text="{Binding DisplayStartDate, StringFormat='Course Start Date: {0}'}" FontSize="14" TextColor="#666"/>
                                    <Label Text="{Binding DisplayEndDate, StringFormat='Course End Date: {0}'}" FontSize="14" TextColor="#666"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>
        <!--Banner Menu Buttons-->
        <Grid x:Name="DropdownPanel"
            IsVisible="False"
            BackgroundColor="Transparent"
            Padding="10"
            HorizontalOptions="End"
            VerticalOptions="Start"
            AbsoluteLayout.LayoutBounds="1,0,0.6,AutoSize"
            AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional">
            <Frame BackgroundColor="#F5F0F6"
                   BorderColor="#8BB174"
                   CornerRadius="15"
                   Padding="20"
                   VerticalOptions="End"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Button Text="Log Out"
                            BackgroundColor="#25564E"
                            TextColor="#F5F0F6"
                            FontAttributes="Bold"
                            Clicked="LogoutButton_Clicked" />
                    <Button Text="Cancel"
                            BackgroundColor="#25564E"
                            TextColor="#F5F0F6"
                            FontAttributes="Bold"
                            Clicked="CancelButton_Clicked"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </AbsoluteLayout>
</ContentPage>