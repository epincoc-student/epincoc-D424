<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
   xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="D424__Eric_Pincock.Pages.MainPage"
             BackgroundColor="#F5F0F6">
    <AbsoluteLayout>
        <Grid AbsoluteLayout.LayoutBounds="0,0,1,1"
                  AbsoluteLayout.LayoutFlags="All"
                  RowDefinitions="0.15*,0.75*,0.10*">
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>
            <!-- Page Banner -->
            <Grid Grid.Row="0" BackgroundColor="#25564E"
                          ColumnDefinitions="0.85*,0.15*"
                          Padding="10">
                <!-- Label Column -->
                <Label Grid.Column="0"
                               Text="Degree Selection"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#F5F0F6"
                               VerticalOptions="Center"
                               HorizontalOptions="Start" />
                <!-- Button Column -->
                <Button Grid.Column="1"
                                x:Name="DetailsButton"
                                Text="..."
                                FontAttributes="Bold"
                                FontSize="28"
                                TextColor="#F5F0F6"
                                BackgroundColor="Transparent"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                Clicked="DetailsButton_Clicked"/>
            </Grid>
            <!-- Scrollable Content -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="30,0" Spacing="25">
                    <Label Text="Select a Degree:"
                               FontSize="18"
                               Margin="10"
                               FontAttributes="Bold"
                               TextColor="#333"
                               HorizontalOptions="Center" />
                    <Picker Title="Choose a major"
                                TitleColor="#000"
                                ItemsSource="{Binding Degrees}"
                                ItemDisplayBinding="{Binding DegreeName}"
                                SelectedItem="{Binding SelectedDegree}"
                                BackgroundColor="#F5F0F6"
                                TextColor="#000"
                                Margin="0,0,0,10" />
                    <Label Text="{Binding ActiveDegree.DegreeName}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#25564E"
                               HorizontalOptions="Center"
                               IsVisible="{Binding ActiveDegree}" />
                    <Label Text="Courses:"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#333"
                               IsVisible="{Binding ActiveDegree}" />
                    <Label Text="{Binding ActiveDegree.TotalCredits, StringFormat='Total Credits: {0}'}"
                               FontSize="16"
                               FontAttributes="Italic"
                               TextColor="#555"
                               HorizontalOptions="Center"
                               IsVisible="{Binding ActiveDegree}" />
                    <CollectionView ItemsSource="{Binding ActiveDegree.DegreeCourses}"
                                        IsVisible="{Binding ActiveDegree}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BorderColor="#ccc"
                                           CornerRadius="10"
                                           Padding="10"
                                           Margin="0,5"
                                           BackgroundColor="#F5F0F6">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding Course.CourseName}" FontSize="14" TextColor="#000" />
                                        <Label Text="{Binding Course.CourseCredits, StringFormat='Credits: {0}'}" FontSize="12" TextColor="#555" />
                                        <Label Text="{Binding Course.PreReqsNeeded, StringFormat='Prerequisites: {0}'}" FontSize="12" TextColor="#555" />
                                        <Label Text="{Binding Course.RequiredCourses.CourseName, StringFormat='Required: {0}'}" FontSize="12" TextColor="#555" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
            <!-- Bottom Button -->
            <Grid Grid.Row="2"
                      Padding="20"
                      BackgroundColor="#F5F0F6"
                      VerticalOptions="Center">
                <Button x:Name="SelectDegreeButton"
                            Text="Select Degree"
                            BackgroundColor="#25564E"
                            TextColor="#F5F0F6"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="45"
                            HorizontalOptions="FillAndExpand"
                            Clicked="SelectDegreeButton_Clicked"/>
            </Grid>
        </Grid>
        <Grid x:Name="DropdownPanel"
              IsVisible="False"
              BackgroundColor="Transparent"
              Padding="10"
              HorizontalOptions="End"
              VerticalOptions="Start"
              AbsoluteLayout.LayoutBounds="1,0,0.6,AutoSize"
              AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional">
            <Frame BackgroundColor="#F5F0F6"
                   BorderColor="#8BB174"
                   CornerRadius="15"
                   Padding="20"
                   VerticalOptions="End"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Button Text="Log Out"
                            BackgroundColor="#25564E"
                            TextColor="#F5F0F6"
                            FontAttributes="Bold"
                            Clicked="LogoutButton_Clicked"/>
                    <Button Text="Cancel"
                            Background="#25564E"
                            TextColor="#F5F0F6"
                            FontAttributes="Bold"
                            Clicked="CancelButton_Clicked"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </AbsoluteLayout>
</ContentPage>