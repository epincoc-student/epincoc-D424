<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
   xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="D424__Eric_Pincock.Pages.TermsPage"
             x:Name="TermsPageRoot"
             BackgroundColor="#F5F0F6">
    <AbsoluteLayout>
        <Grid RowDefinitions="0.15*,0.75*,0.10*"
          AbsoluteLayout.LayoutBounds="0,0,1,1"
          AbsoluteLayout.LayoutFlags="All">
            <!-- Page Banner -->
            <Grid Grid.Row="0" BackgroundColor="#25564E" Padding="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <VerticalStackLayout Grid.Column="0"
                         HorizontalOptions="Start"
                         VerticalOptions="Center"
                         Spacing="4">
                    <Label x:Name="DegreeNameLabel"
                           Text="Current Major: Unknown"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#F5F0F6"
                           HorizontalOptions="Start" />
                    <Label x:Name="CreditHoursLabel"
                           Text="{Binding RemainingCredits, StringFormat='Credits Remaining: {0}'}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#F5F0F6"
                           HorizontalOptions="Start" />
                    <Label x:Name="ProgressPercentLabel"
                           Text="{Binding ProgressPercent, StringFormat='{0}% Completed'}"
                           FontSize="14"
                           TextColor="#F5F0F6"
                           HorizontalOptions="Start" />
                </VerticalStackLayout>
                <!-- Top-right button -->
                <Button Grid.Column="1"
                        Text="..."
                        FontSize="35"
                        FontAttributes="Bold"
                        TextColor="#F5F0F6"
                        BackgroundColor="Transparent"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Clicked="OnBannerMenuClicked" />
            </Grid>
            <!-- Scrollable Terms List -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="30" Spacing="255">
                    <CollectionView ItemsSource="{Binding UserTerms}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BorderColor="#ccc"
                                       CornerRadius="10"
                                       Padding="10"
                                       Margin="0,5"
                                       BackgroundColor="#F5F0F6">
                                    <Grid>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference TermsPageRoot}, 
                                                Path=BindingContext.SelectTermCommand}"
                                                CommandParameter="{Binding}" />
                                        </Grid.GestureRecognizers>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Left column: Term name and details -->
                                        <VerticalStackLayout Grid.Column="0"
                                                             Spacing="5"
                                                             HorizontalOptions="Start"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding TermName}"
                                                   FontSize="20"
                                                   TextColor="#000"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Start" />
                                            <Label Text="{Binding TermStatus}"
                                                   FontSize="14"
                                                   TextColor="#555"
                                                   HorizontalOptions="Start" />
                                            <Label Text="{Binding TermStartDate, StringFormat='Start: {0:MMM dd, yyyy}'}"
                                                   FontSize="14"
                                                   TextColor="#555"
                                                   HorizontalOptions="Start" />
                                            <Label Text="{Binding TermEndDate, StringFormat='End: {0:MMM dd, yyyy}'}"
                                                   FontSize="14"
                                                   TextColor="#555"
                                                   HorizontalOptions="Start" />
                                            <Label Text="{Binding TotalCredits, StringFormat='Total Credits: {0}'}"
                                                   FontSize="14"
                                                   TextColor="#333"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Start" />
                                            <Label Text="Courses:" FontSize="14" TextColor="#333" FontAttributes="Bold" />
                                            <CollectionView ItemsSource="{Binding AssociatedCourses}">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <VerticalStackLayout>
                                                            <Label Text="{Binding DisplayCourseWithCredits}"
                                                                   FontSize="12"
                                                                   TextColor="#666" />
                                                            <Label Text="This course is from a different degree"
                                                                   FontSize="12"
                                                                   TextColor="Red"
                                                                   IsVisible="{Binding IsFromDifferentDegree}" />
                                                        </VerticalStackLayout>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </VerticalStackLayout>
                                        <!-- Right column: Edit button -->
                                        <VerticalStackLayout Grid.Column="1"
                                                             HorizontalOptions="End"
                                                             VerticalOptions="Start">
                                            <Button Text="Edit"
                                                    FontSize="12"
                                                    Padding="10,4"
                                                    BackgroundColor="#F5F0F6"
                                                    TextColor="#333"
                                                    CornerRadius="6"
                                                    Command="{Binding Source={x:Reference TermsPageRoot}, Path=BindingContext.EditTermCommand}"
                                                    CommandParameter="{Binding}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
            <!-- Bottom Button -->
            <Grid Grid.Row="2"
              Padding="20"
              BackgroundColor="#F5F0F6"
              VerticalOptions="Center">
                <Button x:Name="AddTermButton"
                    Text="Add New Term"
                    BackgroundColor="#25564E"
                    TextColor="#F5F0F6"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="45"
                    HorizontalOptions="FillAndExpand"
                    Clicked="AddTermButton_Clicked"/>
            </Grid>
        </Grid>
        <Grid x:Name="BannerMenu"
            IsVisible="False"
            BackgroundColor="Transparent"
            Padding="10"
            HorizontalOptions="End"
            VerticalOptions="Start"
            AbsoluteLayout.LayoutBounds="1,0,0.6,AutoSize"
            AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional">
            <Frame BackgroundColor="#F5F0F6"
                   BorderColor="#8BB174"
                   CornerRadius="15"
                   Padding="20"
                   VerticalOptions="End"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Button Text="Change Degree"
                            BackgroundColor="#25564E"
                            TextColor="#F5F0F6"
                            FontAttributes="Bold"
                            Clicked="OnChangeDegreeClicked" />
                    <Button Text="User Reports"
                            BackgroundColor="#25564E"
                            TextColor="#F5F0F6"
                            FontAttributes="Bold"
                            Clicked="OnUserReportsButton_Clicked"/>
                    <Button Text="Log Out"
                            BackgroundColor="#25564E"
                            TextColor="#F5F0F6"
                            FontAttributes="Bold"
                            Clicked="OnLogOutClicked" />
                    <Button Text="Cancel"
                            BackgroundColor="#25564E"
                            TextColor="#F5F0F6"
                            FontAttributes="Bold"
                            Clicked="CancelButton_Clicked"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>
        <!-- Fly-In Term Editor -->
        <Grid x:Name="TermEditorPanel"
            IsVisible="False"
            TranslationY="500"
            Opacity="0"
            BackgroundColor="#F5F0F6"
            Padding="30"
            VerticalOptions="FillAndExpand"
            HorizontalOptions="FillAndExpand"
            RowDefinitions="*,Auto"
            AbsoluteLayout.LayoutBounds="0,1,1,0.6"
            AbsoluteLayout.LayoutFlags="All"
            ZIndex="10">
            <Frame BackgroundColor="#8BB174"
               CornerRadius="15"
               Padding="20"
               VerticalOptions="End"
               HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Edit Term" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           TextColor="#F5F0F6" 
                           HorizontalOptions="Center" />
                    <Entry x:Name="TermNameEntry"
                        Placeholder="Enter Term Name"
                        PlaceholderColor="#F5F0F6"
                        FontSize="16"
                        TextColor="#F5F0F6" />
                    <Picker x:Name="TermStatusPicker"
                            Title="Select Term Status"
                            FontSize="16"
                            TextColor="#F5F0F6"
                            TitleColor="#F5F0F6"
                            SelectedIndex="0"
                            BackgroundColor="#8BB174">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Upcoming</x:String>
                                <x:String>In Progress</x:String>
                                <x:String>Completed</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                    <DatePicker x:Name="TermStartDatePicker"
                                Format="MMM dd, yyyy"
                                MinimumDate="2020-01-01"
                                MaximumDate="2030-12-31" 
                                TextColor="#F5F0F6"/>
                    <DatePicker x:Name="TermEndDatePicker"
                            Format="MMM dd, yyyy"
                            MinimumDate="2020-01-01"
                            MaximumDate="2030-12-31" 
                            TextColor="#F5F0F6"/>
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Save Term"
                            BackgroundColor="#25564E"
                            TextColor="#F5F0F6"
                            FontAttributes="Bold"
                            Clicked="SaveTermButton_Clicked"
                            HorizontalOptions="FillAndExpand" />
                        <Button Text="Delete Term"
                            x:Name="DeleteTermButton"
                            IsVisible="False"
                            BackgroundColor="#25564E"
                            TextColor="#F5F0F6"
                            FontAttributes="Bold"
                            Clicked="DeleteTermButton_Clicked"
                            HorizontalOptions="FillAndExpand" />
                    </HorizontalStackLayout>
                    <Button Text="Cancel"
                        BackgroundColor="#25564E"
                        TextColor="#F5F0F6"
                        FontAttributes="Bold"
                        Clicked="CancelTermEdit_Clicked"
                        HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </AbsoluteLayout>
</ContentPage>