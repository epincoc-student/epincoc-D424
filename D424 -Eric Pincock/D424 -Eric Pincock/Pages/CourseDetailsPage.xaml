<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
   xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="D424__Eric_Pincock.Pages.CourseDetailsPage"
             Title="CourseDetailsPage"
             x:Name="CourseDetailsRoot"
             BackgroundColor="#F5F0F6">
    <AbsoluteLayout>
        <Grid RowDefinitions="0.15*,0.60*,0.15*,0.15*,0.10*"
              AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All">
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>
            <!-- Page Banner -->
            <Grid Grid.Row="0" BackgroundColor="#25564E" Padding="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Back Button -->
                <Button Grid.Column="0"
                        Text="←"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Clicked="OnBackButtonClicked" />
                <!-- Label Column -->
                <Label Grid.Column="1"
                       x:Name="CourseName"
                        Text="{Binding Course.CourseName}"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White"
                        VerticalOptions="Center"
                        HorizontalOptions="Start" />
                <!-- Button Column -->
                <Button Grid.Column="2"
                        x:Name="DetailsButton"
                        Text="..."
                        FontAttributes="Bold"
                        FontSize="28"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Clicked="DetailsButton_Clicked"/>
            </Grid>
            <!-- Middle Content -->
            <VerticalStackLayout Grid.Row="1"
                     Padding="20"
                     Spacing="10"
                     BackgroundColor="#F5F0F6">
                <Grid ColumnDefinitions="3*,1*"
                      Padding="10"
                      VerticalOptions="Start"
                      HorizontalOptions="FillAndExpand"
                      BackgroundColor="#F5F0F6">
                    <!-- Course Info and Notes -->
                    <VerticalStackLayout Grid.Column="0"
                         Spacing="10"
                         HorizontalOptions="Start">
                        <Label Text="{Binding Course.StartDate, StringFormat='Start Date: {0:MMM dd, yyyy}'}"
                               FontSize="16"
                               TextColor="#333" />
                        <Label Text="{Binding Course.EndDate, StringFormat='End Date: {0:MMM dd, yyyy}'}"
                               FontSize="16"
                               TextColor="#333" />
                        <Label Text="{Binding Course.Status, StringFormat='Status: {0}'}"
                               FontSize="16"
                               TextColor="#333" />
                        <Editor x:Name="NotesEditor"
                                Placeholder="Enter notes here..."
                                Text="{Binding Course.Notes}"  
                                AutoSize="TextChanges"
                                BackgroundColor="White"
                                TextColor="#160C28"
                                FontSize="16"
                                Margin="0,10"
                                HeightRequest="100" 
                                HorizontalOptions="Start"
                                WidthRequest="{OnPlatform Android=300, iOS=300, WinUI=450}"/>
                        <Button x:Name="SaveNotesButton"
                                WidthRequest="100"
                                HorizontalOptions="Start"
                                Text="Save Notes"
                                BackgroundColor="#25564E"
                                TextColor="#F5F0F6"
                                Clicked="SaveNotesButton_Clicked"/>
                    </VerticalStackLayout>
                    <!-- Notification Button -->
                    <Button Grid.Column="1"
                            BackgroundColor="Transparent"
                            WidthRequest="70"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Clicked="AddNotificationButton_Clicked">
                        <Button.ImageSource>
                            <FileImageSource File="black_notification_bell.png" />
                        </Button.ImageSource>
                    </Button>
                </Grid>
                <!--Objective Assessments Portion-->
                <Grid ColumnDefinitions="1*,0*">
                    <VerticalStackLayout Grid.Column="0"
                         HorizontalOptions="FillAndExpand"
                         Spacing="10">
                        <!-- Objective Assessment Panel -->
                        <Grid Grid.Row="2"
                              BackgroundColor="#F5F0F6"
                              VerticalOptions="Center">
                            <!-- Objective Assessment Info Panel -->
                            <Grid IsVisible="{Binding HasObjectiveAssessment}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Left Column: Assessment Details -->
                                <StackLayout Grid.Column="0"
                                             VerticalOptions="Center"
                                             Spacing="5">
                                    <Label Text="{Binding ObjectiveAssessment.ObjectiveAssessmentName}"
                                           FontSize="16"
                                           TextColor="#333" />
                                    <Label Text="{Binding ObjectiveAssessment.oaStartDate, StringFormat='Start: {0:MMM dd, yyyy}'}"
                                           FontSize="16"
                                           TextColor="#333" />
                                    <Label Text="{Binding ObjectiveAssessment.oaEndDate, StringFormat='End: {0:MMM dd, yyyy}'}"
                                           FontSize="16"
                                           TextColor="#333" />
                                </StackLayout>
                                <!-- Right Column: Edit Button -->
                                <Button Grid.Column="1"
                                        Text="Edit"
                                        FontSize="12"
                                        Padding="10,4"
                                        BackgroundColor="#eee"
                                        TextColor="#333"
                                        CornerRadius="6"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Clicked="EditObjectiveAssessmentButton_Clicked" />
                            </Grid>
                            <!-- Add Button -->
                            <Button x:Name="AddObjectiveAssessmentButton"
                                    WidthRequest="250"
                                    IsVisible="{Binding ShowAddObjectiveAssessmentButton}"
                                    Text="+ Objective Assessment"
                                    BackgroundColor="#25564E"
                                    TextColor="#F5F0F6"
                                    CornerRadius="10"
                                    HeightRequest="45"
                                    HorizontalOptions="Start"
                                    Clicked="AddObjectiveAssessmentButton_Clicked"/>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
                <!--Performance Assessments Portion-->
                <Grid ColumnDefinitions="1*,0*">
                    <VerticalStackLayout Grid.Column="0"
                         HorizontalOptions="FillAndExpand"
                         Spacing="10">
                        <!-- Performance Assessment Panel -->
                        <Grid Grid.Row="3"
                              BackgroundColor="#F5F0F6"
                              VerticalOptions="Center">
                            <!-- Performance Assessment Info Panel -->
                            <Grid IsVisible="{Binding HasPerformanceAssessment}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Left Column: Assessment Details -->
                                <StackLayout Grid.Column="0"
                                             VerticalOptions="Center"
                                             Spacing="5">
                                    <Label Text="{Binding PerformanceAssessment.PerformanceAssessmentName}"
                                           FontSize="16"
                                           TextColor="#333" />
                                    <Label Text="{Binding PerformanceAssessment.paStartDate, StringFormat='Start: {0:MMM dd, yyyy}'}"
                                           FontSize="16"
                                           TextColor="#333" />
                                    <Label Text="{Binding PerformanceAssessment.paEndDate, StringFormat='End: {0:MMM dd, yyyy}'}"
                                           FontSize="16"
                                           TextColor="#333" />
                                </StackLayout>
                                <!-- Right Column: Edit Button -->
                                <Button Grid.Column="1"
                                        Text="Edit"
                                        FontSize="12"
                                        Padding="10,4"
                                        BackgroundColor="#eee"
                                        TextColor="#333"
                                        CornerRadius="6"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Clicked="EditPerformanceAssessmentButton_Clicked" />
                            </Grid>
                            <!-- Add Button -->
                            <Button x:Name="AddPerformanceAssessmentButton"
                                    WidthRequest="250"
                                    IsVisible="{Binding ShowAddPerformanceAssessmentButton}"
                                    Text="+ Performance Assessment"
                                    BackgroundColor="#25564E"
                                    TextColor="#F5F0F6"
                                    CornerRadius="10"
                                    HeightRequest="45"
                                    HorizontalOptions="Start"
                                    Clicked="AddPerformanceAssessmentButton_Clicked"/>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
            <!-- Bottom Button/Course Instructor Info -->
            <Grid Grid.Row="4"
                  Padding="20"
                  BackgroundColor="#F5F0F6"
                  VerticalOptions="Center">
                <!-- Instructor Info Panel -->
                <Grid IsVisible="{Binding HasInstructor}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Left Column: Instructor Details -->
                    <StackLayout Grid.Column="0"
                                 VerticalOptions="Center"
                                 Spacing="5">
                        <Label Text="Instructor Info"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#25564E" />
                        <Label Text="{Binding Instructor.CourseInstructorName, StringFormat='Name: {0}'}"
                               FontSize="16"
                               TextColor="#333" />
                        <Label Text="{Binding Instructor.CourseInstructorEmail, StringFormat='Email: {0}'}"
                               FontSize="16"
                               TextColor="#333" />
                        <Label Text="{Binding Instructor.CourseInstructorPhone, StringFormat='Phone: {0}'}"
                               FontSize="16"
                               TextColor="#333" />
                    </StackLayout>
                    <!-- Right Column: Edit Button -->
                    <Button Grid.Column="1"
                            Text="Edit"
                            FontSize="14"
                            FontAttributes="Bold"
                            BackgroundColor="#25564E"
                            TextColor="White"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Clicked="EditInstructorButton_Clicked" />
                </Grid>
                <!-- Add Button -->
                <Button x:Name="AddCourseInstructorButton"
                        IsVisible="{Binding ShowAddInstructorButton}"
                        Text="Add Course Instructor"
                        BackgroundColor="#25564E"
                        TextColor="#F5F0F6"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="45"
                        HorizontalOptions="FillAndExpand"
                        Clicked="AddCourseInstructorButton_Clicked"/>
            </Grid>
        </Grid>
        <Grid x:Name="DropdownPanel"
              IsVisible="False"
              BackgroundColor="Transparent"
              Padding="10"
              HorizontalOptions="End"
              VerticalOptions="Start"
              AbsoluteLayout.LayoutBounds="1,0,0.6,AutoSize"
              AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional">
            <Frame BackgroundColor="#F5F0F6"
                   BorderColor="#8BB174"
                   CornerRadius="15"
                   Padding="20"
                   VerticalOptions="End"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Button Text="Log Out"
                        BackgroundColor="#25564E"
                        TextColor="#F5F0F6"
                        FontAttributes="Bold"
                        Clicked="LogoutButton_Clicked"/>
                    <Button Text="Cancel"
                        Background="#25564E"
                        TextColor="#F5F0F6"
                        FontAttributes="Bold"
                        Clicked="CancelButton_Clicked"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>
        <!--Instructor Fly-In Panel-->
        <Grid x:Name="InstructorFlyInPanel"
              IsVisible="False"
              TranslationY="500"
              Opacity="0"
              BackgroundColor="Transparent"
              Padding="20"
              AbsoluteLayout.LayoutBounds="0.5,1,0.9,AutoSize"
              AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional"
              ZIndex="20">
            <Frame BackgroundColor="#8BB174"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Add Instructor"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalOptions="Center" />
                    <Entry x:Name="InstructorNameEntry"
                           Placeholder="Instructor Name"
                           BackgroundColor="White"
                           TextColor="#160C28" />
                    <Entry x:Name="InstructorEmailEntry"
                            Placeholder="Email"
                            BackgroundColor="White"
                            TextColor="#160C28" />
                    <Entry x:Name="InstructorPhoneEntry"
                           Placeholder="Phone"
                           BackgroundColor="#F5F0F6"
                           TextColor="#160C28"/>
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Save"
                                BackgroundColor="#25564E"
                                TextColor="White"
                                Clicked="SaveInstructorButton_Clicked" />
                        <Button Text="Cancel"
                                BackgroundColor="#160C28"
                                TextColor="White"
                                Clicked="CancelInstructorButton_Clicked" />
                        <Button Text="Delete"
                                BackgroundColor="#B00020"
                                TextColor="White"
                                FontAttributes="Bold"
                                IsVisible="{Binding HasInstructor}"
                                Clicked="DeleteInstructorButton_Clicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>
        </Grid>
        <!--Objective Assessment Fly-In Panel-->
        <Grid x:Name="ObjectiveAssessmentFlyInPanel"
              IsVisible="False"
              TranslationY="500"
              Opacity="0"
              BackgroundColor="Transparent"
              Padding="20"
              AbsoluteLayout.LayoutBounds="0.5,1,0.9,AutoSize"
              AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional"
              ZIndex="20">
            <Frame BackgroundColor="#8BB174"
                    CornerRadius="15"
                    Padding="20"
                    HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Entry x:Name="ObjectiveAssessmentNameEntry"
                           Placeholder="Objective Assessment Name"
                           BackgroundColor="White"
                           TextColor="#160C28" />
                    <Label Text="Objective Assessment Start Date"
                               FontAttributes="Bold"
                               TextColor="#F5F0F6"/>
                    <DatePicker x:Name="ObjectiveAssessmentStartDatePicker"
                                 BackgroundColor="#8BB174"
                                 Format="MMM dd, yyyy"
                                 MinimumDate="2020-01-01"
                                 MaximumDate="2030-12-31"
                                 TextColor="#F5F0F6"/>
                    <Label Text="Objective Assessment End Date"
                               FontAttributes="Bold"
                               TextColor="#F5F0F6"/>
                    <DatePicker x:Name="ObjectiveAssessmentEndDatePicker"
                                 BackgroundColor="#8BB174"
                                 Format="MMM dd, yyyy"
                                 MinimumDate="2020-01-01"
                                 MaximumDate="2030-12-31"
                                 TextColor="#F5F0F6"/>
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Save"
                                BackgroundColor="#25564E"
                                TextColor="White"
                                Clicked="SaveObjectiveAssessmentButton_Clicked" />
                        <Button Text="Cancel"
                                BackgroundColor="#160C28"
                                TextColor="White"
                                Clicked="CancelObjectiveAssessmentButton_Clicked" />
                        <Button Text="Delete"
                                BackgroundColor="#B00020"
                                TextColor="White"
                                FontAttributes="Bold"
                                IsVisible="{Binding HasObjectiveAssessment}"
                                Clicked="DeleteObjectiveAssessmentButton_Clicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>
        </Grid>
        <!--Performance Assessment Fly-In Panel-->
        <Grid x:Name="PerformanceAssessmentFlyInPanel"
              IsVisible="False"
              TranslationY="500"
              Opacity="0"
              BackgroundColor="Transparent"
              Padding="20"
              AbsoluteLayout.LayoutBounds="0.5,1,0.9,AutoSize"
              AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional"
              ZIndex="20">
            <Frame BackgroundColor="#8BB174"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Entry x:Name="PerformanceAssessmentNameEntry"
                           Placeholder="Performance Assessment Name"
                           BackgroundColor="White"
                           TextColor="#160C28" />
                    <Label Text="Performance Assessment Start Date"
                           FontAttributes="Bold"
                           TextColor="#F5F0F6"/>
                    <DatePicker x:Name="PerformanceAssessmentStartDatePicker"
                                BackgroundColor="#8BB174"
                                Format="MMM dd, yyyy"
                                MinimumDate="2020-01-01"
                                MaximumDate="2030-12-31"
                                TextColor="#F5F0F6"/>
                    <Label Text="Performance Assessment End Date"
                           FontAttributes="Bold"
                           TextColor="#F5F0F6"/>
                    <DatePicker x:Name="PerformanceAssessmentEndDatePicker"
                                BackgroundColor="#8BB174"
                                Format="MMM dd, yyyy"
                                MinimumDate="2020-01-01"
                                MaximumDate="2030-12-31"
                                TextColor="#F5F0F6"/>
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Save"
                                BackgroundColor="#25564E"
                                TextColor="White"
                                Clicked="SavePerformanceAssessmentButton_Clicked" />
                        <Button Text="Cancel"
                                BackgroundColor="#160C28"
                                TextColor="White"
                                Clicked="CancelPerformanceAssessmentButton_Clicked" />
                        <Button Text="Delete"
                                BackgroundColor="#B00020"
                                TextColor="White"
                                FontAttributes="Bold"
                                IsVisible="{Binding HasPerformanceAssessment}"
                                Clicked="DeletePerformanceAssessmentButton_Clicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>
        </Grid>
        <!--Notifications Fly-In Panel-->
        <Grid x:Name="NotificationsFlyInPanel"
                IsVisible="False"
                TranslationY="500"
                Opacity="0"
                BackgroundColor="Transparent"
                Padding="20"
                AbsoluteLayout.LayoutBounds="0.5,1,0.9,AutoSize"
                AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional"
                ZIndex="20">
            <Frame BackgroundColor="#8BB174"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Add Course Notification"
                           FontAttributes="Bold"
                           FontSize="24"
                           TextColor="#F5F0F6"/>
                    <Entry x:Name="NotificationNameEntry"
                           Placeholder="Notification Name"
                           BackgroundColor="White"
                           TextColor="#160C28" />
                    <Label Text="Notification Date"
                           FontAttributes="Bold"
                           TextColor="#F5F0F6"/>
                    <DatePicker x:Name="NotificationDatePicker"
                                BackgroundColor="#8BB174"
                                Format="MMM dd, yyyy"
                                MinimumDate="2020-01-01"
                                MaximumDate="2030-12-31"
                                TextColor="#F5F0F6"/>
                    <Label Text="Notification Time"
                           FontAttributes="Bold"
                           TextColor="#F5F0F6"/>
                    <TimePicker x:Name="NotificationTimePicker"
                                BackgroundColor="#8BB174"
                                TextColor="#F5F0F6"/>
                    <Editor x:Name="NotificationDescriptionEditor"
                           Placeholder="Notification Notes"
                           BackgroundColor="White"
                           TextColor="#160C28"
                           HeightRequest="100"
                           VerticalOptions="Start"
                           HorizontalOptions="FillAndExpand" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Save Notification"
                                BackgroundColor="#25564E"
                                TextColor="White"
                                Clicked="SaveNotificationButton_Clicked" />
                        <Button Text="Cancel"
                                BackgroundColor="#160C28"
                                TextColor="White"
                                Clicked="CancelNotificationButton_Clicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </AbsoluteLayout>
</ContentPage>